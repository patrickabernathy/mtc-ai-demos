# Copy this file to .env.local and fill in all three.
# .env.local is in .gitignore. This file is not, so never put a real one here.

# In Neon: your project -> Connect -> pick the "store" database -> copy.
NEON_DATABASE_URL=

# Better Auth signs every login cookie with this, so nobody can forge one.
# It's a password for your app: long, random, and never shared.
# Make one with the same randomBytes as Tuesday's session ids:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Forget it and the app still runs on your laptop -- then refuses to start
# once it's deployed. Every deployment gets its own.
BETTER_AUTH_SECRET=

# Where the app is running. On Vercel, this is your real address.
BETTER_AUTH_URL=http://localhost:3000
